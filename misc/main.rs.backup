// ============================================================================
// MAIN FUNCTION
// ============================================================================

fn main() -> Result<()> {
    env_logger::init();

    let args = Args::parse();

    if args.list_devices {
        DeviceLister::list_all_devices();
        return Ok(());
    }

    let config = load_or_create_config(&args.config)?;
    print_startup_info(&args, &config)?;

    let app = App::new(config);
    let event_loop = EventLoop::new()?;
    event_loop.run_app(&mut { app })?;
    Ok(())
}