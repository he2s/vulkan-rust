// state management
#[derive(Clone, Debug)]
pub struct FrameState {
    pub midi: MidiStateSnapshot,
    pub audio_levels: AudioLevels,
    pub osc: OscStateSnapshot,
    pub beat: BeatState,  // Add this field
}

// vertex data structures
#[repr(C)]
#[derive(Clone, Copy)]
struct Vertex {
    pos: [f32; 2],
    uv: [f32; 2],
}

#[repr(C)]
#[derive(Clone, Copy)]
struct InstanceData {
    offset: [f32; 2],
    scale: [f32; 2],
    rotation_cos: f32,    // Pre-computed cos
    rotation_sin: f32,    // Pre-computed sin
    color_index: u32,     // Back to u32 for alignment
    _padding: u32,        // Alignment padding
}

// Point data structure matching the compute shader
#[repr(C)]
#[derive(Clone, Copy)]
struct PointData {
    position: [f32; 2],
    size: f32,
    intensity: f32,
    color: [f32; 4],
    rotation: f32,
    point_type: u32,
    velocity: [f32; 2],
}

// push constants
#[repr(C)]
#[derive(Clone, Copy)]
pub struct PushConstants {
    time: f32,
    mouse_x: u32,
    mouse_y: u32,
    mouse_pressed: u32,
    note_velocity: f32,
    pitch_bend: f32,
    cc1: f32,
    cc74: f32,
    note_count: u32,
    last_note: u32,
    osc_ch1: f32,
    osc_ch2: f32,
    render_w: u32,
    render_h: u32,
    bpm: f32,
    time_to_next_beat: f32,
    time_since_last_beat: f32,
    beats_per_bar: u32,
    max_points: u32,
    fft_size: u32,
    audio_intensity: f32,
    bass_level: f32,
    mid_level: f32,
    high_level: f32,
}

